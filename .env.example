# Runtime
NODE_ENV=production
PORT=3000
JWT_SECRET=replace-with-a-long-random-string
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_NAME=Admin

# Public app URLs
# Cloudflare Pages frontend URL, for example https://dr.example.com
FRONTEND_ORIGIN=https://your-frontend-domain.example
# Backend/API URL, for example https://api-dr.example.com
VITE_API_BASE_URL=https://your-backend-domain.example

# OAuth
VITE_APP_ID=
VITE_OAUTH_PORTAL_URL=
OAUTH_SERVER_URL=https://your-backend-domain.example
OWNER_OPEN_ID=

# Database
DATABASE_URL=mysql://user:password@host:3306/database

# Settrade Open API
SETTRADE_BROKER_ID=022
SETTRADE_APP_ID=
SETTRADE_APP_SECRET=
SETTRADE_REQUIRE_REALTIME=true
DR_UNIVERSE_EXTRA=
# Optional: set DR_UNIVERSE to replace the built-in list entirely with comma-separated symbols.
DR_UNIVERSE=
DR_ALLOWED_SUFFIXES=23,80
DR_INCLUDE_GENERATED_VARIANTS=true
DR_SCAN_BATCH_SIZE=8

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional Forge/Manus integrations
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
